# ──────────────────────────────────────────────
# Transport mode
# ──────────────────────────────────────────────
# "stdio" for local Claude Desktop / Claude Code CLI
# "http"  for remote / shared / containerized deployments
TRANSPORT=stdio

# ──────────────────────────────────────────────
# Broker SEMP v2
# ──────────────────────────────────────────────
SEMP_BASE_URL=https://your-broker:943/SEMP/v2
SEMP_USERNAME=readonly-semp-user
SEMP_PASSWORD=your-semp-password
SOLACE_VPN=default

# ──────────────────────────────────────────────
# Event Portal (optional — leave blank to skip EP tools)
# ──────────────────────────────────────────────
SOLACE_CLOUD_TOKEN=your-event-portal-bearer-token

# ──────────────────────────────────────────────
# HTTP transport only (not needed for stdio)
# ──────────────────────────────────────────────
HTTP_PORT=3000
HTTP_HOST=127.0.0.1
# Generate a strong API key (at least 32 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=
# Comma-separated origins for CORS; supports wildcards via minimatch
ALLOWED_ORIGINS=http://localhost:*
